source_up
export RR=`pwd`

export PGGSSENCMODE=disable
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES


export PGDSN=postgresql://postgres:@localhost:5432/ragdoll_demo_development?sslmode=disable
export JOB_CONCURRENT=4

############################################################
# SolidQueue workers were crashing due to YJIT compatibility issues with Ruby 3.4.6 on
# macOS ARM. I've temporarily disabled the worker process so the Rails server can start successfully.

export RUBY_YJIT_ENABLE=false
export MALLOC_ARENA_MAX=2

# To re-enable workers later (once you've confirmed the web server works), uncomment the worker line in
# Procfile.dev and try these fixes:
# - RUBY_YJIT_ENABLE=false ./bin/jobs start
# - Add memory limits: MALLOC_ARENA_MAX=2 RUBY_YJIT_ENABLE=false ./bin/jobs start
#
